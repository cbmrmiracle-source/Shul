# PostgreSQL connection string
DATABASE_URL=postgres://postgres@localhost:5432/shul

# Single-user login. Choose a strong password.
APP_PASSWORD=change-me
# Random string of 32+ characters used to sign the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Where uploaded images are stored (use a persistent volume in production)
# UPLOAD_DIR=/data/uploads

# Public address of the app, used for image links in the email (e.g. https://shul.example.org)
# PUBLIC_BASE_URL=
